{
  "name": "snitchlint",
  "displayName": "SnitchLint",
  "publisher": "preethivhiremath",
  "description": "SAST for JavaScript/TypeScript — OWASP rules, taint analysis, AI explanations & secure fix suggestions in VS Code.",
  "version": "0.2.0",
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "security",
    "sast",
    "owasp",
    "sql injection",
    "xss",
    "lint",
    "ai",
    "cwe",
    "taint analysis"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "SnitchLint",
      "properties": {
        "snitchlint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable SnitchLint security analysis for supported languages."
        },
        "snitchlint.debounceMs": {
          "type": "number",
          "default": 400,
          "minimum": 50,
          "description": "Debounce delay (ms) after edits before re-running analysis."
        },
        "snitchlint.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "warn",
          "description": "Verbosity for the SnitchLint output channel."
        },
        "snitchlint.rules": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-rule toggles. Set a rule id to `false` to disable it (e.g. `\"snitchlint.rules\": { \"sql-injection\": false }`).",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "snitchlint.ai.ollamaEnabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use a local [Ollama](https://ollama.com) model to enhance explanations (free, runs on your machine). No data leaves your computer."
        },
        "snitchlint.ai.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama API base URL."
        },
        "snitchlint.ai.ollamaModel": {
          "type": "string",
          "default": "llama3.2",
          "description": "Ollama model name (e.g. llama3.2, phi3, codellama)."
        },
        "snitchlint.ai.useVsCodeLm": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use the VS Code Language Model API when available (e.g. Copilot). Explanations work offline without this."
        }
      }
    },
    "commands": [
      {
        "command": "snitchlint.scan",
        "title": "SnitchLint: Scan Active File"
      },
      {
        "command": "snitchlint.scanWorkspace",
        "title": "SnitchLint: Scan Workspace (SARIF)"
      },
      {
        "command": "snitchlint.showAiInsight",
        "title": "SnitchLint: Explain Vulnerability & Suggest Fix",
        "icon": "$(lightbulb)"
      },
      {
        "command": "snitchlint.showAiInsightForDiagnostic",
        "title": "SnitchLint: Explain (internal)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "snitchlint.showAiInsight",
          "when": "editorLangId =~ /javascript|typescript|javascriptreact|typescriptreact/",
          "group": "snitchlint@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test:unit": "npm run compile-tests && npx mocha \"out/test/unit/**/*.test.js\"",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/mock-require": "^3.0.0",
    "@types/node": "20.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {}
}
